<?xml version="1.0" encoding="utf-8"?>
<odoo noupdate="1">

    <record id="seq_field_visit_plan" model="ir.sequence">
        <field name="name">Field Visit Plan</field>
        <field name="code">field.visit.plan</field>
        <field name="prefix">PLAN/%(year)s/</field>
        <field name="padding">4</field>
        <field name="company_id" eval="False"/>
    </record>

    <record id="seq_field_sale_order" model="ir.sequence">
        <field name="name">Field Sale Order</field>
        <field name="code">field.sale.order</field>
        <field name="prefix">SO-</field>
        <field name="padding">6</field>
        <field name="company_id" eval="False"/>
    </record>

    <record id="seq_field_payment" model="ir.sequence">
        <field name="name">Field Payment Voucher</field>
        <field name="code">field.payment</field>
        <field name="prefix">PAY-</field>
        <field name="padding">6</field>
        <field name="company_id" eval="False"/>
        <!-- Deliberately ONE sequence, shared across every branch and
             every delegate in the whole program - never resets - so a
             printed receipt number is always globally unambiguous. -->
    </record>

</odoo>