<?xml version="1.0" encoding="utf-8"?>
<odoo>

    <record id="view_field_visit_plan_move_line_form" model="ir.ui.view">
        <field name="name">field.visit.plan.move.line.form</field>
        <field name="model">field.visit.plan.move.line</field>
        <field name="arch" type="xml">
            <form>
                <group>
                    <field name="customer_id" readonly="1"/>
                    <field name="current_visit_date" readonly="1"/>
                    <field name="new_date"/>
                </group>
                <group>
                    <field name="scope" widget="radio"/>
                    <field name="following_count" readonly="1"
                           invisible="scope != 'rest'"/>
                </group>
                <footer>
                    <button name="action_move" type="object"
                            string="Confirm" class="btn-primary"/>
                    <button string="Cancel" class="btn-secondary"
                            special="cancel"/>
                </footer>
            </form>
        </field>
    </record>

    <record id="action_field_visit_plan_move_line" model="ir.actions.act_window">
        <field name="name">Reschedule Visit</field>
        <field name="res_model">field.visit.plan.move.line</field>
        <field name="view_mode">form</field>
        <field name="target">new</field>
        <field name="binding_model_id" ref="model_field_visit"/>
        <field name="binding_view_types">form,list,kanban</field>
    </record>

</odoo>
