<?xml version="1.0" encoding="utf-8"?>
<odoo>

    <record id="view_field_visit_plan_extend_form" model="ir.ui.view">
        <field name="name">field.visit.plan.extend.form</field>
        <field name="model">field.visit.plan.extend</field>
        <field name="arch" type="xml">
            <form>
                <group>
                    <field name="plan_id" readonly="1"/>
                    <field name="schedule_generated_until" readonly="1"/>
                </group>
                <group>
                    <field name="extend_mode" widget="radio"/>
                    <field name="extend_days"
                           invisible="extend_mode != 'days'"/>
                    <field name="extend_until_date"
                           invisible="extend_mode != 'until_date'"/>
                </group>
                <footer>
                    <button name="action_extend" type="object"
                            string="Extend" class="btn-primary"/>
                    <button string="Cancel" class="btn-secondary"
                            special="cancel"/>
                </footer>
            </form>
        </field>
    </record>

    <record id="action_field_visit_plan_extend" model="ir.actions.act_window">
        <field name="name">Extend Schedule</field>
        <field name="res_model">field.visit.plan.extend</field>
        <field name="view_mode">form</field>
        <field name="target">new</field>
    </record>

</odoo>
