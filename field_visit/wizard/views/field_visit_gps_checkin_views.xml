<?xml version="1.0" encoding="utf-8"?>
<odoo>

    <record id="view_field_visit_gps_checkin_form" model="ir.ui.view">
        <field name="name">field.visit.gps.checkin.form</field>
        <field name="model">field.visit.gps.checkin</field>
        <field name="arch" type="xml">
            <form>
                <group>
                    <field name="customer_id" readonly="1" invisible="stage == 'return_to_branch'"/>
                    <field name="branch_id" readonly="1" invisible="stage != 'return_to_branch'"/>
                    <field name="stage" invisible="1"/>
                    <field name="stage_label" readonly="1" string="Action"/>
                </group>
                <group string="Your Location">
                    <field name="latitude" widget="field_visit_gps_capture" nolabel="1" colspan="2"/>
                    <field name="longitude" invisible="1"/>
                    <field name="gps_ok" invisible="1"/>
                </group>
                <group invisible="not gps_ok">
                    <field name="distance_km" readonly="1"/>
                    <field name="proximity_threshold_km" readonly="1" string="Allowed Range"/>
                    <field name="is_within_range" invisible="1"/>
                </group>
                <group invisible="is_within_range or not gps_ok">
                    <field name="exception_reason"
                           placeholder="e.g. Customer asked to meet at a different location..."
                           required="not is_within_range"/>
                </group>
                <footer>
                    <button name="action_confirm" type="object"
                            string="Confirm" class="btn-primary"
                            invisible="not gps_ok"/>
                    <button string="Cancel" class="btn-secondary" special="cancel"/>
                </footer>
            </form>
        </field>
    </record>

    <record id="action_field_visit_gps_checkin" model="ir.actions.act_window">
        <field name="name">Confirm Location</field>
        <field name="res_model">field.visit.gps.checkin</field>
        <field name="view_mode">form</field>
        <field name="target">new</field>
    </record>

</odoo>