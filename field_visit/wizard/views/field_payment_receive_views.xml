<?xml version="1.0" encoding="utf-8"?>
<odoo>

    <record id="view_field_payment_receive_form" model="ir.ui.view">
        <field name="name">field.payment.receive.form</field>
        <field name="model">field.payment.receive</field>
        <field name="arch" type="xml">
            <form>
                <group>
                    <field name="delegate_id" readonly="1"/>
                    <field name="total_amount" readonly="1"/>
                    <field name="payment_ids" widget="many2many_tags" readonly="1"/>
                </group>
                <footer>
                    <button name="action_confirm" type="object"
                            string="Confirm Receipt" class="btn-primary"/>
                    <button string="Cancel" class="btn-secondary" special="cancel"/>
                </footer>
            </form>
        </field>
    </record>

    <record id="action_field_payment_receive" model="ir.actions.act_window">
        <field name="name">Receive Custody</field>
        <field name="res_model">field.payment.receive</field>
        <field name="view_mode">form</field>
        <field name="target">new</field>
        <field name="binding_model_id" ref="model_field_payment"/>
        <field name="binding_view_types">list</field>
    </record>

</odoo>
