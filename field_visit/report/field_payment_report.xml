<?xml version="1.0" encoding="utf-8"?>
<odoo>

    <record id="action_report_field_payment" model="ir.actions.report">
        <field name="name">Payment Receipt</field>
        <field name="model">field.payment</field>
        <field name="report_type">qweb-pdf</field>
        <field name="report_name">field_visit.report_field_payment_document</field>
        <field name="report_file">field_visit.report_field_payment_document</field>
        <field name="print_report_name">'Receipt - %s' % (object.name)</field>
        <field name="binding_model_id" ref="model_field_payment"/>
        <field name="binding_type">report</field>
    </record>

    <template id="report_field_payment_document">
        <t t-call="web.html_container">
            <t t-foreach="docs" t-as="o">
                <t t-call="web.external_layout">
                    <div class="page">
                        <h2 class="text-center">Payment Receipt</h2>
                        <h3 class="text-center text-muted">
                            <span t-field="o.name"/>
                        </h3>
                        <hr/>
                        <div class="row mt32">
                            <div class="col-6">
                                <strong>Received From:</strong>
                                <p t-field="o.customer_id.name"/>
                            </div>
                            <div class="col-6 text-end">
                                <strong>Date:</strong>
                                <p t-field="o.payment_date"/>
                            </div>
                        </div>
                        <table class="table table-bordered mt32">
                            <tr>
                                <td><strong>Amount</strong></td>
                                <td>
                                    <span t-field="o.amount"
                                          t-options="{'widget': 'monetary', 'display_currency': o.currency_id}"/>
                                </td>
                            </tr>
                            <tr>
                                <td><strong>Payment Method</strong></td>
                                <td><span t-field="o.payment_method"/></td>
                            </tr>
                            <tr>
                                <td><strong>Collected By</strong></td>
                                <td><span t-field="o.delegate_id.user_id.name"/></td>
                            </tr>
                            <tr>
                                <td><strong>Branch</strong></td>
                                <td><span t-field="o.branch_id.name"/></td>
                            </tr>
                        </table>
                        <div class="row mt64">
                            <div class="col-6">
                                <p>Delegate Signature: ______________________</p>
                            </div>
                            <div class="col-6">
                                <p>Customer Signature: ______________________</p>
                            </div>
                        </div>
                    </div>
                </t>
            </t>
        </t>
    </template>

</odoo>
