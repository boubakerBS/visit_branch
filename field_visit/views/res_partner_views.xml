<?xml version="1.0" encoding="utf-8"?>
<odoo>

    <record id="view_partner_form_field_visit" model="ir.ui.view">
        <field name="name">res.partner.form.field.visit</field>
        <field name="model">res.partner</field>
        <field name="inherit_id" ref="base.view_partner_form"/>
        <field name="arch" type="xml">
            <xpath expr="//div[@class='o_address_format']" position="after">
            <group>
                
                    <field name="field_visit_latitude" placeholder="Latitude"/>
                    <field name="field_visit_longitude" placeholder="Longitude"/>
                
            </group>
            </xpath>
        </field>
    </record>

</odoo>