<?xml version="1.0" encoding="utf-8"?>
<odoo>

    <record id="view_field_sale_order_list" model="ir.ui.view">
        <field name="name">field.sale.order.list</field>
        <field name="model">field.sale.order</field>
        <field name="arch" type="xml">
            <list>
                <field name="name"/>
                <field name="order_date"/>
                <field name="customer_id"/>
                <field name="delegate_id"/>
                <field name="fulfillment_source" widget="badge"/>
                <field name="amount_total" sum="Total"/>
            </list>
        </field>
    </record>

    <record id="view_field_sale_order_form" model="ir.ui.view">
        <field name="name">field.sale.order.form</field>
        <field name="model">field.sale.order</field>
        <field name="arch" type="xml">
            <form>
                <header>
                    <button name="%(action_report_field_sale_order)d" type="action"
                            string="Print" class="btn-secondary"
                            icon="fa-print"/>
                </header>
                <sheet>
                    <div class="oe_title">
                        <h1><field name="name" readonly="1"/></h1>
                    </div>
                    <group>
                        <group>
                            <field name="customer_id" readonly="1"/>
                            <field name="visit_id" readonly="1"/>
                            <field name="order_date" readonly="context.get('default_visit_id') and True or False"/>
                        </group>
                        <group>
                            <field name="delegate_id" readonly="1"/>
                            <field name="fulfillment_source"
                                   readonly="line_ids and id"/>
                            <field name="amount_total" readonly="1"/>
                        </group>
                    </group>
                    <notebook>
                        <page string="Order Lines">
                            <field name="line_ids">
                                <list editable="bottom">
                                    <field name="product_id"/>
                                    <field name="quantity"/>
                                    <field name="price_unit"/>
                                    <field name="subtotal" sum="Total"/>
                                </list>
                            </field>
                        </page>
                    </notebook>
                </sheet>
                <chatter/>
            </form>
        </field>
    </record>

    <record id="action_field_sale_order" model="ir.actions.act_window">
        <field name="name">Sale Orders</field>
        <field name="res_model">field.sale.order</field>
        <field name="view_mode">list,form</field>
    </record>

</odoo>