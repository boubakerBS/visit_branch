<?xml version="1.0" encoding="utf-8"?>
<odoo>

    <record id="view_field_delegate_config_list" model="ir.ui.view">
        <field name="name">field.delegate.config.list</field>
        <field name="model">field.delegate.config</field>
        <field name="arch" type="xml">
            <list>
                <field name="user_id"/>
                <field name="branch_id"/>
                <field name="customer_count"/>
                <field name="weekly_visit_frequency"/>
                <field name="visits_per_day_estimate" string="~Visits/Day"/>
            </list>
        </field>
    </record>

    <record id="view_field_delegate_config_form" model="ir.ui.view">
        <field name="name">field.delegate.config.form</field>
        <field name="model">field.delegate.config</field>
        <field name="arch" type="xml">
            <form>
                <sheet>
                    <div class="oe_button_box" name="button_box">
                        <button name="%(action_field_visit_plan_generate)d"
                                type="action" class="oe_stat_button"
                                icon="fa-magic"
                                context="{'default_delegate_id': id}">
                            <div class="o_stat_info">
                                <span class="o_stat_text">Generate Plan</span>
                            </div>
                        </button>
                    </div>
                    <group>
                        <group>
                            <field name="user_id"/>
                            <field name="branch_id"/>
                        </group>
                        <group>
                            <field name="weekly_visit_frequency"/>
                            <field name="customer_count"/>
                            <field name="visits_per_day_estimate"
                                   string="Estimated visits/day"/>
                        </group>
                    </group>
                    <group string="Working Days">
                        <group>
                            <field name="work_sat"/>
                            <field name="work_sun"/>
                            <field name="work_mon"/>
                            <field name="work_tue"/>
                        </group>
                        <group>
                            <field name="work_wed"/>
                            <field name="work_thu"/>
                            <field name="work_fri"/>
                        </group>
                    </group>
                    <notebook>
                        <page string="Assigned Customers">
                            <field name="customer_assignment_ids">
                                <list editable="bottom">
                                    <field name="customer_id"/>
                                </list>
                            </field>
                        </page>
                    </notebook>
                </sheet>
            </form>
        </field>
    </record>

    <record id="action_field_delegate_config" model="ir.actions.act_window">
        <field name="name">Delegates</field>
        <field name="res_model">field.delegate.config</field>
        <field name="view_mode">list,form</field>
        <field name="help" type="html">
            <p class="o_view_nocontent_smart_action">Configure your first delegate</p>
            <p>Set one uniform weekly visit frequency and working days
               per delegate - it applies to every customer assigned to
               them.</p>
        </field>
    </record>

</odoo>
