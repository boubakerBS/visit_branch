<?xml version="1.0" encoding="utf-8"?>
<odoo>

    <record id="view_field_payment_list" model="ir.ui.view">
        <field name="name">field.payment.list</field>
        <field name="model">field.payment</field>
        <field name="arch" type="xml">
            <list decoration-warning="state in ('in_custody', 'to_verify')"
                  decoration-success="state in ('handed_over', 'verified')">
                <field name="name"/>
                <field name="payment_date"/>
                <field name="customer_id"/>
                <field name="delegate_id"/>
                <field name="amount" sum="Total"/>
                <field name="payment_method"/>
                <field name="state" widget="badge"/>
            </list>
        </field>
    </record>

    <record id="view_field_payment_form" model="ir.ui.view">
        <field name="name">field.payment.form</field>
        <field name="model">field.payment</field>
        <field name="arch" type="xml">
            <form>
                <header>
                    <button name="%(action_report_field_payment)d" type="action"
                            string="Print Receipt" class="btn-secondary"
                            icon="fa-print"/>
                    <button name="action_resend_sms" type="object"
                            string="Resend SMS" class="btn-secondary"
                            icon="fa-commenting"
                            invisible="sms_state == 'sent'"/>
                    <button name="action_hand_over" type="object"
                            string="Confirm Receipt" class="btn-primary"
                            invisible="state != 'in_custody'"
                            groups="field_visit.group_field_supervisor"/>
                    <button name="action_hand_over" type="object"
                            string="Verify Amount" class="btn-primary"
                            invisible="state != 'to_verify'"
                            groups="field_visit.group_field_supervisor"/>
                    <!-- Cash is held by the delegate; every other method
                         only needs the amount to be verified. -->
                    <field name="state" widget="statusbar"
                           statusbar_visible="in_custody,handed_over"
                           invisible="payment_method != 'cash'"/>
                    <field name="state" widget="statusbar"
                           statusbar_visible="to_verify,verified"
                           invisible="payment_method == 'cash'"/>
                </header>
                <sheet>
                    <div class="oe_title">
                        <h1><field name="name" readonly="1"/></h1>
                    </div>
                    <group>
                        <group>
                            <field name="customer_id" readonly="1"/>
                            <field name="visit_id" readonly="1"/>
                            <field name="payment_date" readonly="state not in ('in_custody', 'to_verify')"/>
                        </group>
                        <group>
                            <field name="delegate_id" readonly="1"/>
                            <field name="amount" readonly="state not in ('in_custody', 'to_verify')"/>
                            <field name="payment_method" readonly="state not in ('in_custody', 'to_verify')"/>
                        </group>
                    </group>
                    <group>
                        <field name="notes" placeholder="Add any notes about this payment..."
                               readonly="state not in ('in_custody', 'to_verify')"/>
                    </group>
                    <group string="Customer SMS">
                        <field name="sms_state" readonly="1" widget="badge"
                               decoration-success="sms_state == 'sent'"
                               decoration-danger="sms_state == 'failed'"
                               decoration-warning="sms_state == 'no_phone'"/>
                        <field name="sms_datetime" readonly="1" invisible="not sms_datetime"/>
                        <field name="sms_error" readonly="1" invisible="not sms_error"/>
                    </group>
                    <group invisible="state in ('in_custody', 'to_verify')">
                        <field name="handed_over_datetime" readonly="1"/>
                        <field name="handed_over_by_id" readonly="1"/>
                    </group>
                </sheet>
                <chatter/>
            </form>
        </field>
    </record>

    <record id="action_field_payment" model="ir.actions.act_window">
        <field name="name">Collections</field>
        <field name="res_model">field.payment</field>
        <field name="view_mode">list,form</field>
    </record>

</odoo>